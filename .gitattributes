# 默认按文本处理并统一 LF（macOS 单平台项目，避免 CRLF 噪音）
* text=auto eol=lf

# 源码 / 脚本 / 文档
*.swift   text diff=swift
*.js      text
*.mjs     text
*.sh      text eol=lf
*.py      text
*.md      text
*.mermaid text
*.json    text
*.plist   text
*.yml     text
*.yaml    text

# 二进制：禁止行尾转换与文本 diff
*.png  binary
*.jpg  binary
*.pdf  binary
*.apk  binary
*.zip  binary
*.ogg  binary
*.ogg_ binary
*.png_ binary
*.efkefc binary

# RGSS 数据文件：Marshal 二进制，往返断言依赖字节完全不变
# （git 的 text=auto 一般能识别 NUL，但显式声明才能保证任何检出配置下都不被转换）
*.rxdata  binary
*.rvdata  binary
*.rvdata2 binary

# 第三方 fixture 的工程文件要**字节原样**：Game.ini 是 CRLF，且 sha256 记在
# PROVENANCE 里。text=auto 会把它改成 LF，往返/校验就对不上了。
Fixtures/*-real/Game.ini -text
